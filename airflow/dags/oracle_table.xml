<?xml version="1.0" encoding="UTF-8"?>
<sql-config version="1.0">
    <!-- 1. 데이터 테이블 설정 -->
    <data>
        <table>
            <id>SH_PROMOTIONS</id>
            <schema>SH</schema>
            <name>PROMOTIONS</name>
            <load-type>FULL</load-type>
            <auto-load-range/>
            <statistics>
                <sum-columns/>
            </statistics>
            <sql><![CDATA[
                SELECT
                    PROMO_ID,
                    PROMO_NAME,
                    PROMO_SUBCATEGORY,
                    PROMO_SUBCATEGORY_ID,
                    PROMO_CATEGORY,
                    PROMO_CATEGORY_ID,
                    PROMO_COST,
                    PROMO_BEGIN_DATE,
                    PROMO_END_DATE,
                    PROMO_TOTAL,
                    PROMO_TOTAL_ID
                FROM SH.PROMOTIONS
            ]]></sql>
        </table>

        <table>
            <id>SH_COSTS</id>
            <schema>SH</schema>
            <name>COSTS</name>
            <load-type>PERIOD</load-type>
            <auto-load-range>3D</auto-load-range>
            <statistics>
                <sum-columns>
                    <column>UNIT_COST</column>
                    <column>UNIT_PRICE</column>
                </sum-columns>
            </statistics>
            <sql><![CDATA[
                SELECT
                    PROD_ID,
                    TIME_ID,
                    PROMO_ID,
                    CHANNEL_ID,
                    UNIT_COST,
                    UNIT_PRICE
                FROM SH.COSTS
                WHERE TIME_ID + (365*4) >= TO_DATE(:BASE_DATE, 'YYYYMMDD')
                  AND TIME_ID + (365*4) <  TO_DATE(:BASE_DATE, 'YYYYMMDD') + 1
            ]]></sql>
        </table>

        <table>
            <id>SH_COSTS_MM</id>
            <schema>SH</schema>
            <name>COSTS_MM</name>
            <load-type>PERIOD</load-type>
            <auto-load-range>3M</auto-load-range>
            <statistics>
                <sum-columns>
                    <column>UNIT_COST</column>
                    <column>UNIT_PRICE</column>
                </sum-columns>
            </statistics>
            <sql><![CDATA[
                SELECT
                    PROD_ID,
                    TIME_ID,
                    PROMO_ID,
                    CHANNEL_ID,
                    UNIT_COST,
                    UNIT_PRICE
                FROM SH.COSTS
                WHERE TO_CHAR(TIME_ID + (365*4), 'YYYYMM') = :BASE_DATE
            ]]></sql>
        </table>

        <table>
            <id>SH_COSTS_YYYY</id>
            <schema>SH</schema>
            <name>SH_COSTS_YYYY</name>
            <load-type>PERIOD</load-type>
            <auto-load-range>3Y</auto-load-range>
            <statistics>
                <sum-columns>
                    <column>UNIT_COST</column>
                    <column>UNIT_PRICE</column>
                </sum-columns>
            </statistics>
            <sql><![CDATA[
                SELECT
                    PROD_ID,
                    TIME_ID,
                    PROMO_ID,
                    CHANNEL_ID,
                    UNIT_COST,
                    UNIT_PRICE
                FROM SH.COSTS
                WHERE TO_CHAR(TIME_ID + (365*4), 'YYYY') = :BASE_DATE
            ]]></sql>
        </table>

    </data>

